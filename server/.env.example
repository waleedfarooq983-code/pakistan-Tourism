# ==============================================================================
# DISCOVER PAKISTAN - BACKEND CONFIGURATION (.env)
# ==============================================================================

# Server Environment
PORT=5000
NODE_ENV=development

# Allowed Frontend Origins (comma-separated for CORS)
CLIENT_URL=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000,http://127.0.0.1:3000,http://localhost:8080

# Database (MongoDB Atlas URI or local MongoDB)
# Replace with your Atlas connection string:
# mongodb+srv://<username>:<password>@cluster0.mongodb.net/discover_pakistan?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/discover_pakistan

# JWT Secrets (Generate strong 64-char strings in production: openssl rand -base64 48)
JWT_ACCESS_SECRET=discover_pakistan_jwt_access_super_secret_key_2026_change_in_production
JWT_REFRESH_SECRET=discover_pakistan_jwt_refresh_super_secret_key_2026_change_in_production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Initial Admin Credentials (used by scripts/seed.js)
ADMIN_EMAIL=admin@discoverpakistan.pk
ADMIN_PASSWORD=admin123
ADMIN_NAME=Super Admin
ADMIN_PHONE=03001234567

# Email Service (Nodemailer)
# Leave SMTP_USER empty to automatically use Ethereal test accounts with preview URLs!
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Discover Pakistan" <no-reply@discoverpakistan.pk>

# SMS / OTP Service (Twilio)
# Leave empty to log OTPs to server console during development
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Cloudinary (Image Uploads)
# Leave empty to use local fallback during local testing
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Payment Gateway (Stripe)
# Leave empty to use built-in Mock Payment processor
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Payment Gateway (JazzCash / EasyPaisa)
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_INTEGRITY_SALT=
